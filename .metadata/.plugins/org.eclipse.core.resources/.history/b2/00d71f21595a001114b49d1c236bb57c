package com.kdj;

public class Ex3 {

	public static void main(String[] args) {
		int i = 0;
		while (i < 5) {
			System.out.println(i);
			i++;
		}
		
//		do while
		i = 0;
		
		do {
			System.out.println(i);
			i++;
		}
		
		while (i < 5);
		
//		for 제어문
	    for (int k = 0; k < 5; k++) {
	        System.out.println(k);
	    }
	}

}
