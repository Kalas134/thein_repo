package com.kdj;

public class Ex3 {

	public static void main(String[] args) {
//		for 제어문
	    for (int i = 0; i < 5; i++) {
	        System.out.println(i);
	        }

//		Outer loop
	    for (int i = 1; i <= 2; i++) {
	    	System.out.println("Outer: " + i); // Executes 2 times
//		Inner loop
	    	for (int j = 1; j <= 3; j++) {
	    		System.out.println(" Inner: " + j); // Executes 6 times (2 * 3)
	    		}
	    	}
	    
	    int i_row;
	    int j_col;
	    
	    i_row = 5;
	    j_col = 5;
	    
//		Outer loop
	    for (int i = 0; i < i_row; i++) {
	    	System.out.println("Outer(i_row): " + i); // Executes 2 times
//		Inner loop
	    	for (int j = 0; j < j_col; j++) {
	    		System.out.println(" Inner(j_col): " + j); // Executes 6 times (2 * 3)
	    		}
	    	}
	    }
	}
